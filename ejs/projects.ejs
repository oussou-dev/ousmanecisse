<div class="quarto-listing quarto-listing-container-grid">
    <div class="list grid quarto-listing-cols-3">
        <% for (const item of items) { %>
            <div class="g-col-1" <%=metadataAttrs(item) %>>
                <div class="quarto-grid-item card h-100 card-left">
                    <p class="card-img-top">
                        <img src="<%= item.image %>" class="thumbnail-image card-img"
                            style="height: 150px; object-fit: cover;">
                    </p>
                    <div class="card-body post-contents">
                        <h5 class="no-anchor card-title listing-title">
                            <%= item.title %>
                        </h5>
                        <div class="card-text listing-description">
                            <%= item.description %>
                        </div>

                        <div class="project-buttons mt-3 d-flex flex-wrap gap-2">
                            <% if (item.github_url) { %>
                                <a href="<%= item.github_url %>" class="btn btn-outline-dark btn-sm" target="_blank">
                                    <i class="bi bi-github"></i> GitHub
                                </a>
                                <% } %>
                                    <% if (item.blog_url) { %>
                                        <a href="<%= item.blog_url %>" class="btn btn-primary btn-sm" target="_blank">
                                            <i class="bi bi-journal-text"></i> Blog
                                        </a>
                                        <% } %>
                        </div>

                        <% if (item.categories) { %>
                            <div class="listing-categories mt-3">
                                <% for (const category of item.categories) { %>
                                    <div class="listing-category"
                                        onclick="window.quartoListingCategory('<%= category %>'); return false;">
                                        <%= category %>
                                    </div>
                                    <% } %>
                            </div>
                            <% } %>
                    </div>
                </div>
            </div>
            <% } %>
    </div>
</div>